# Supabase — aman untuk klien
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — hanya server (JANGAN diberi awalan NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Cron keep-alive (dikirim Vercel sebagai header Authorization Bearer)
CRON_SECRET=

# Email (Resend)
RESEND_API_KEY=
# Opsional: alamat pengirim untuk notifikasi suspend (default: onboarding@resend.dev)
EMAIL_FROM=

# Cloudflare Turnstile (login/daftar/reset). Kosongkan untuk menonaktifkan (dev).
# Kunci uji resmi Cloudflare untuk verifikasi lokal:
#   selalu-lolos: sitekey 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
#   selalu-gagal: sitekey 2x00000000000000000000AA, secret 2x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (rate limit + cache, dipakai fase berikutnya)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
